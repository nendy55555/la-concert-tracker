# Copy to .env and fill in real values. .env is gitignored.
# Required when running `weekly_digest.py --email`.

# Gmail account that sends the digest (the address you generated the App Password under).
GMAIL_SENDER=you@gmail.com

# 16-character Google App Password. Spaces are fine — script strips them.
# Generate one at https://myaccount.google.com/apppasswords (2FA must be on).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional override for the recipient. Defaults to GMAIL_SENDER.
# EMAIL_TO=someone-else@example.com

# Ticketmaster Discovery API consumer key (public event metadata). Same key Row 5 uses.
TM_DISCOVERY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
